# Known-good bootstrap profile (CachyOS/Linux):
# - QEMU TCG (no KVM): more compatible with current Debian Ports hurd-amd64 images
# - AHCI disk bus: avoids PIIX IDE DMA timeouts seen on some boots
# - VNC/noVNC enabled for interactive bootstrap when SSH is broken
#
# Usage:
#   set -a; source ./config/profiles/vnc-tcg-ahci.env; set +a
#   make up-vnc
#
SSH_PORT=2223
HTTP_PORT=8081
SERIAL_PORT=5556
MONITOR_PORT=9998
VNC_PORT=5901
NOVNC_PORT=6081

DISABLE_KVM=1
QEMU_DISK_BUS=ahci
ENABLE_9P=1

# If you want remote noVNC from another PC on your LAN:
# NOVNC_BIND=0.0.0.0
