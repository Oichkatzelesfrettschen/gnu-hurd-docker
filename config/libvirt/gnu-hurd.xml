<?xml version="1.0" encoding="UTF-8"?>
<!--
GNU/Hurd libvirt Domain Definition
==================================

This libvirt domain XML defines a GNU/Hurd x86_64 virtual machine for
local development and compatibility testing.

USAGE:
  1. Customize memory/vCPU/image path as needed.
  2. Define the domain: virsh define gnu-hurd.xml
  3. Start the VM: virsh start gnu-hurd
  4. Connect via VNC or serial/telnet console.

NOTES:
  - User-mode networking with host forwards:
      127.0.0.1:2222 -> guest:22 (SSH)
      127.0.0.1:8080 -> guest:80 (HTTP)
  - TCP console exposed on 127.0.0.1:5555 (telnet protocol)
-->
<domain type="kvm">
  <name>gnu-hurd</name>
  <uuid>a1b2c3d4-e5f6-47a8-9b0c-1d2e3f4a5b6c</uuid>
  <title>GNU/Hurd Microkernel x86_64</title>
  <description>Debian GNU/Hurd development and testing environment</description>

  <memory unit="MiB">4096</memory>
  <currentMemory unit="MiB">4096</currentMemory>
  <vcpu placement="static">2</vcpu>

  <cpu mode="host-passthrough" check="none">
    <topology sockets="1" cores="2" threads="1"/>
  </cpu>

  <os>
    <type arch="x86_64" machine="pc">hvm</type>
    <boot dev="hd"/>
    <bios useserial="yes" rebootTimeout="5000"/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <pae/>
  </features>

  <clock offset="utc">
    <timer name="rtc" tickpolicy="catchup"/>
    <timer name="pit" tickpolicy="delay"/>
    <timer name="hpet" present="no"/>
  </clock>

  <pm>
    <suspend-to-mem supported="no"/>
    <suspend-to-disk supported="no"/>
  </pm>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <controller type="ide" index="0">
      <alias name="ide"/>
    </controller>
    <controller type="usb" index="0" model="piix3-uhci"/>
    <controller type="pci" index="0" model="pci-root"/>

    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2" cache="writeback" io="threads"/>
      <source file="/var/lib/libvirt/images/debian-hurd-amd64.qcow2"/>
      <target dev="hda" bus="ide"/>
      <address type="drive" controller="0" bus="0" target="0" unit="0"/>
    </disk>

    <interface type="user">
      <mac address="52:54:00:12:34:56"/>
      <model type="e1000"/>
      <source>
        <portForward family="ipv4" address="127.0.0.1" start="2222" end="2222">
          <range start="22" end="22"/>
        </portForward>
        <portForward family="ipv4" address="127.0.0.1" start="8080" end="8080">
          <range start="80" end="80"/>
        </portForward>
      </source>
    </interface>

    <graphics type="vnc" port="-1" autoport="yes" listen="127.0.0.1">
      <listen type="address" address="127.0.0.1"/>
    </graphics>

    <console type="tcp">
      <target type="serial" port="0"/>
      <protocol type="telnet"/>
      <source mode="bind" host="127.0.0.1" service="5555" tls="no"/>
    </console>

    <serial type="pty">
      <target type="isa-serial" port="0">
        <model name="isa-serial"/>
      </target>
    </serial>

    <input type="mouse" bus="ps2"/>
    <input type="keyboard" bus="ps2"/>

    <memballoon model="virtio"/>
    <rng model="virtio">
      <backend model="builtin"/>
    </rng>
  </devices>
</domain>
