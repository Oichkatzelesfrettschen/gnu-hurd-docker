# VirtualBox defaults for unattended Debian GNU/Hurd amd64 installs.

# VM identity
VBOX_VM_NAME=gnu-hurd-amd64-auto
VBOX_OS_TYPE=Debian_64

# Resource sizing
VBOX_RAM_MB=4096
VBOX_CPUS=2
VBOX_VRAM_MB=16

# Storage
VBOX_CONTROLLER_NAME="SATA Controller"
VBOX_DISK_PATH=infrastructure/cache/images/virtualbox/gnu-hurd-amd64-auto.vdi
VBOX_DISK_SIZE_MB=40960

# Installer media (generated by setup-daily-installer)
VBOX_ISO_PATH=infrastructure/cache/images/installers/debian-hurd-amd64-installer.latest-mini-auto.iso

# Networking
VBOX_NATPF_RULE_NAME=ssh
VBOX_HOST_SSH_PORT=2224

# Serial for emergency diagnostics
VBOX_UART_PORT=4555

# Wait policy
VBOX_INSTALL_TIMEOUT_SEC=3600
VBOX_BOOT_TIMEOUT_SEC=600
