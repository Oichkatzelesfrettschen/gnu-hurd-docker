# Resolve hurd-amd64 package closures on a Linux host, without booting a guest.
#
# Hurd userland cannot execute here. A hurd-amd64 binary is x86-64, so the
# machine matches, but it names /lib/ld-x86-64.so.1 as its interpreter and links
# libdiskfs, libports, and libpager, whose calls are Mach RPC. Supplying that
# loader does not help: on a Linux kernel it dies with SIGSEGV before it runs
# any program, because its first operations are Mach traps Linux does not
# implement. docs/audits/hurd-execution-boundary.md records the probe.
#
# What crosses the boundary is the archive as data. apt and dpkg are ordinary
# Linux programs, and APT::Architecture makes hurd-amd64 the native architecture
# of a private apt state tree. Dependency resolution, availability, and version
# facts therefore come from the real debian-ports index rather than from a guest
# that takes minutes to boot and holds one mutable qcow2.
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

# ca-certificates carries the TLS roots for deb.debian.org; debian-ports-archive-keyring
# carries the signing key debian-ports uses, so the index is verified rather than
# fetched with [trusted=yes].
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      apt-utils \
      ca-certificates \
      debian-ports-archive-keyring \
      python3 \
 && rm -rf /var/lib/apt/lists/*

# A private tree keeps the foreign architecture out of the container's own apt
# state, so the image stays installable and the query stays reproducible.
# The apt state tree is built at run time, because the target architecture and
# the LMDE overlay are run-time choices: one image answers hurd-i386 and
# hurd-amd64 rather than baking one of them in.
RUN mkdir -p /srv/hurd-apt

COPY scripts/report-hurd-package-closure.py /usr/local/bin/report-hurd-package-closure

ENTRYPOINT ["/usr/local/bin/report-hurd-package-closure"]
