# Disk Images (large files - download from cdimage.debian.org)
# Images are now stored in images/ directory
# Large files should be downloaded, not committed to git
*.img
*.qcow2
*.tar.xz
*.tar.gz
backup-*.tar.gz
images/*.img
images/*.qcow2
images/*.tar.xz

# VM backup/snapshot spillover should never be versioned from images/
images/debian-hurd-amd64.qcow2.bak*
images/debian-hurd-amd64.qcow2.*.bak
images/debian-hurd-amd64.qcow2.pre-*
images/debian-hurd-amd64.qcow2.post-*

# Local infrastructure cache for large transient VM artifacts
infrastructure/cache/images/*
!infrastructure/cache/images/README.md

# QEMU logs and output
qemu*.log
serial*.log
*.pid
hurd_serial.log

# Docker artifacts
.docker/

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Python and scripts
__pycache__/
*.pyc
.env.local
venv/
.venv/

# Temporary files
/tmp/
/temp/
*.tmp

# Local/generated audit artifacts
docs/audits/LINK-SCAN-REPORT.md
docs/audits/link-scan-data.json

# Build artifacts
build/
!build/README.md

# Source materials (downloaded upstream files)
src/*
!src/README.md

# npm/yarn audit logs
logs/
!logs/README.md
*.audit.json
*.img.bak.*

# Docker secrets (actual credentials - NEVER commit)
secrets/*.txt
!secrets/*.txt.example
# CREDENTIALS.txt moved to docs/ (contains default public credentials only)

# Claude Code local settings (auto-approvals and personal config)
.claude/*.local.json
ssh-test-keys/hurd_test_key
mint-sources/
*.db
link-scan.json

# Generated runtime captures are dated instances and stay untracked.
# evidence/runtime/cases/ holds deliberate, sanitized captures that are
# argued artifacts and are tracked.
evidence/runtime/*
!evidence/runtime/cases/

# A capture's stdout is its primary evidence, and a global core.excludesFile
# commonly ignores *.out as build output. That rule silently kept every .out
# from the tracked cases while their .err counterparts committed, so a clone
# received hashes for streams it did not have. A repository rule overrides the
# global file, so the retained stdout travels with the capture that cites it.
!evidence/runtime/cases/**/*.out
